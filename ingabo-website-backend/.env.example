PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/ingabo
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIRECTORY=./uploads

# SMTP / transactional email (optional in development — API still boots without it)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.org
SMTP_PASSWORD=replace-me
MAIL_FROM=mailer@example.org
MAIL_ADMIN=team@example.org
FRONTEND_URL=http://localhost:3000
